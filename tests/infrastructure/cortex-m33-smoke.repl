// Minimal Cortex-M33 machine used only to validate the Renode toolchain.
// It does not describe any STM32U5 device.
rom: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x1000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x1000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic
