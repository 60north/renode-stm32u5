*** Test Cases ***
Should Measure Period And Pulse Width In PWM Input Mode
    # No firmware: the core is halted.
    Execute Command                 cpu IsHalted true
    # TIM3: PWM mode 1 on channel 1, period 50000 timer clocks, pulse 12500 clocks.
    Write Word                      ${TIM3} + ${PSC}      0
    Write Word                      ${TIM3} + ${ARR}      49999
    Write Word                      ${TIM3} + ${CCR1}     12500
    Write Word                      ${TIM3} + ${CCMR1}    0x0060
    Write Word                      ${TIM3} + ${CCER}     0x0001
    # TIM2: CC1S = 01 (TI1), CC2S = 10 (TI1), CC2P = 1 (falling), TS = TI1FP1, SMS = reset mode.
    Write Word                      ${TIM2} + ${PSC}      0
    Write Word                      ${TIM2} + ${ARR}      0xFFFFFFFF
    Write Word                      ${TIM2} + ${CCMR1}    0x0201
    Write Word                      ${TIM2} + ${CCER}     0x0031
    Write Word                      ${TIM2} + ${SMCR}     0x0054
    Write Word                      ${TIM2} + ${CR1}      1
    Write Word                      ${TIM3} + ${CR1}      1
    Execute Command                 emulation RunFor "0.1"
    # The counter counts from 0 to N - 1 over a period of N clocks: CCR1 = N - 1 (RM0456 55.4.8).
    Word Should Be                  ${TIM2} + ${CCR1}     49999
    Word Should Be                  ${TIM2} + ${CCR2}     12499
