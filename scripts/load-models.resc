:name: STM32U5 models
:description: Compiles the STM32U5 peripheral models kept in this repository. Include it before loading an STM32U5 platform description.

# One include compiles all models in one assembly (one compilation instead of one per file).
include $ORIGIN/../peripherals/CPU/STM32U5_TrustZoneContext.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_GTZC.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_PWR.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_RCC.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_RCCSecurity.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_ICACHE.cs $ORIGIN/../peripherals/MTD/STM32U5_FlashController.cs $ORIGIN/../peripherals/GPIOPort/STM32U5_GPIOPort.cs $ORIGIN/../peripherals/IRQControllers/STM32U5_EXTI.cs $ORIGIN/../peripherals/UART/STM32U5_USART.cs $ORIGIN/../peripherals/SPI/STM32U5_SPI.cs $ORIGIN/../peripherals/SD/STM32U5_SDCard.cs $ORIGIN/../peripherals/SD/STM32U5_SDMMC.cs $ORIGIN/../peripherals/SPI/STM32U5_OCTOSPI.cs $ORIGIN/../peripherals/SPI/STM32U5_OCTOSPIM.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_FMC.cs $ORIGIN/../peripherals/GPIOPort/STM32U5_LPGPIO.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_HASH.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_SYSCFG.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_DCACHE.cs $ORIGIN/../peripherals/I2C/STM32U5_I2C.cs $ORIGIN/../peripherals/CAN/STM32U5_FDCAN.cs $ORIGIN/../peripherals/DMA/STM32U5_GPDMA.cs $ORIGIN/../peripherals/Timers/STM32U5_Timer.cs $ORIGIN/../peripherals/Timers/STM32U5_RTC.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_TAMP.cs $ORIGIN/../peripherals/Timers/STM32U5_IWDG.cs $ORIGIN/../peripherals/Analog/STM32U5_ADC.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_DBGMCU.cs $ORIGIN/../peripherals/Miscellaneous/STM32U5_RNG.cs $ORIGIN/../peripherals/CPU/STM32U5_IDAU.cs
